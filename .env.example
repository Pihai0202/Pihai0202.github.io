# Firebase Configuration API Keys (Copy this file to .env.local and replace with your real keys)
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# TDX API Credentials (Optional: to fetch real-time TRA/HSR/Bus timetables)
# Vite exposes VITE_* values to the browser. Use a restricted TDX app/key pair for this static site.
VITE_TDX_CLIENT_ID=YOUR_TDX_CLIENT_ID
VITE_TDX_CLIENT_SECRET=YOUR_TDX_CLIENT_SECRET
